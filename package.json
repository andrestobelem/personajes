    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
